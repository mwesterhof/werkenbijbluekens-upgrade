{% extends "base.html.twig" %}

{% block content %}

    {% include 'partials/hero.html.twig' with {
        'image' : content.header_image,
        'title' : content.title
    } %}

    <div class="container py-5">
        <div class="row">
            <div class="col-md-7">

                <div class="container">
                    <p class="lead text-dark">{{ content.page_intro|striptags }}</p>
                </div>

                {% for block in content.content_blocks %}
                    {% include "contentBlocks/#{block.type}.html.twig" with {
                        content: block,
                        view: view.content_blocks[loop.index0],
                    } only %}
                {% endfor %}
            </div>
            <div class="col-md-5 col-lg-4 ml-lg-auto">
                {% set story = sulu_content_load(content.story) %}

                {% if story %}
                    <div>
                        {% include 'partials/list-item-story.html.twig'
                            with {
                                'images': story.extension.excerpt.images,
                                'title': story.extension.excerpt.title,
                                'description': story.extension.excerpt.description,
                                'namePerson': story.content.name_person,
                                'url': story.content.url
                            }
                        %}
                    </div>
                {% endif %}

                {% include 'partials/share-this.html.twig' with {
                    'label' : 'dit functieprofiel'
                } %}
            </div>
        </div>
    </div>

    {% include 'partials/jobs-listing-inline.html.twig'
       with {
            'jobs' : content.joboffers
       }
    %}

    {%  include 'partials/application.html.twig'
        with {
            'label': 'Stuur een open sollicitatie!'
        }
    %}

{% endblock %}

<div class="bg-white p-2 py-md-5 h-100">
    <div class="row">
        <div class="title col-12 col-md-1 text-md-nowrap justify-content-center align-items-center d-flex">
            {% if sideLabel == true %}
                <p class="lead mb-2 mb-md-0 font-weight-regular text-md-vertical">{{ story.title }}</p>
            {% endif %}
        </div>
        <div class="image col-12 col-md-5 position-relative">
            {% for image in story.excerptImages %}
                <img src="{{ image.formats['800x800'] }}" alt="" class="img-fluid">
            {% endfor %}
        </div>
        <div class="text col-12 col-md-5 d-flex flex-column justify-content-center pl-md-5">
            <div class="h5 my-1">{{ story.excerptTitle|raw }}</div>
            <div class="mb-1">{{ story.excerptDescription|raw }}</div>

            {% if readmoreLink == true %}
                {%  include 'components/button-orange-outline.html.twig'
                    with {
                        'label': story.excerptMore ? story.excerptMore : 'Lees meer',
                        'url':  story.url
                }
                %}
            {% endif %}

        </div>
    </div>
</div>

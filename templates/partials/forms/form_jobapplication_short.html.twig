<div class="container-xl py-5 pb-lg-0" id="applicationformAnchor">
    <div class="container p-0 px-sm-1 px-md-1 p-xl-0">
        <div class="row">
            <div class="col-12 col-lg-8 col-xl-6 d-flex flex-column justify-content-center">
                {% if app.request.get('send') != 'true' %}
                    <h2 class="line-height-1 pb-3 text-4xl text-dark">
                        {{ label }}
                        <br>
                        <small>Alle velden zijn verplicht.</small>
                    </h2>

                    {# FORM THEME #}
                    {# {% form_theme content.form '@SuluForm/themes/basic.html.twig' %} #}

                    {% form_theme content.form with [
                        'bootstrap_4_layout.html.twig',
                        'formthemes/honeypot.html.twig'
                    ] %}

                    {{ form_start(content.form, {'attr': {
                            'id': 'dynamic-form',
                            'action' : '#applicationformAnchor'
                    }}) }}

                    <div class="row">
                        <div class="form-group col-12">
                            {{ form_widget(content.form.text, {'attr': {'class': 'form-control border-top-0 border-left-0 border-right-0 border-dark border-w-2' }}) }}
                            {{ form_label(content.form.text, content.form.text.vars.label, {'label_attr': {'class': 'text-black-50'}}) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12">
                            {{ form_widget(content.form.city, {'attr': {'class': 'form-control border-top-0 border-left-0 border-right-0 border-dark border-w-2' }}) }}
                            {{ form_label(content.form.city, content.form.city.vars.label, {'label_attr': {'class': 'text-black-50'}}) }}
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-12 col-md-6">
                            {{ form_widget(content.form.email, {'attr': {'class': 'form-control border-top-0 border-left-0 border-right-0 border-dark border-w-2' }}) }}
                            {{ form_label(content.form.email, content.form.email.vars.label, {'label_attr': {'class': 'text-black-50'}}) }}
                        </div>
                        <div class="form-group col-12 col-md-6">
                            {{ form_widget(content.form.phone, {'attr': {'class': 'form-control border-top-0 border-left-0 border-right-0 border-dark border-w-2' }}) }}
                            {{ form_label(content.form.phone, content.form.phone.vars.label, {'label_attr': {'class': 'text-black-50'}}) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 mb-3">
                            {{ form_label(content.form.textarea, content.form.textarea.vars.label, {'label_attr': {'class': 'px-0_5 text-black-50'}}) }}
                            {{ form_widget(content.form.textarea, {'attr': {'rows' : '5', 'class': 'form-control border border-dark border-w-2' }}) }}
                            
                        </div>
                    </div>
                    {% if content.form.dropdown is defined %}
                    <div class="row">
                        <div class="form-group col-12">
                            {{ form_widget(content.form.dropdown, {'attr': {'class': 'form-control border-top-0 border-left-0 border-right-0 border-dark border-w-2' }}) }}
                            {{ form_label(content.form.dropdown, content.form.dropdown.vars.label, {'label_attr': {'class': 'text-black-50'}}) }}
                        </div>
                    </div>
                    {% endif %}

                    <div class="row">
                        <div class="form-group col-12 col-md-6 small">
                            Door te solliciteren ga ik er mee akkoord dat Bluekens Truck en Bus bv mijn persoonsgegevens verwerkt volgens haar privacybeleid.
                        </div>
                        <div class="form-group col-12 col-md-6">
                            {{ form_widget(content.form.submit, {'attr': {'class': 'w-100 text-center border bg-secondary border-secondary font-weight-bold hover-bg-to-dark justify-content-between no-deco px-2 py-0_5 text-white text-uppercase' }}) }}

                            <p class="small pt-1 small text- text-black-50 text-center">
                                <a href="/privacy-policy" class="text-dark" target="_self"><u>Lees hier ons privacybeleid.</u></a>
                            </p>

                        </div>
                    </div>

        
                    <div class="form-group">
                        <div class="font-italic">Wij streven er naar om je binnen vijf werkdagen te voorzien van een gepast antwoord.</div>
                    </div>

{#
                    {{ form_widget(content.form.text6, {
                            'attr': {'class': 'd-none' },
                            'value': app.request.requesturi
                        })
                    }} #}

                    {{ form_end(content.form) }}

                {% else %}
                    <div class="bg-primary p-5 text-white mb-5">
                        {{ view.form.entity.successText|replace({ '<h5>': '<h5 class="text-white mb-2">'})
                            |raw
                        }}
                    </div>
                {% endif %}
            </div>
            <div class="d-none d-lg-flex col-lg-4 col-xl-6 {{ type is defined and type == 'form-left' ? 'order-last' : 'order-first' }}  align-items-end">
                {% if content.joboffer_image %}
                    {% for image in content.joboffer_image %}
                        <img src="{{ image.formats['700x'] }}" alt="Solliciteer!" class="img-fluid">
                    {% endfor %}
                {% else %}
                    {#
                    <!-- no default image any more -->
                    <img src="{{ asset('build/frontend/images/jobapplication.png') }}" alt="Solliciteer!" class="img-fluid">
                    #}
                {% endif %}
            </div>
        </div>
    </div>
</div>
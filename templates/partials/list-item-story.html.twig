<figure class="position-relative d-flex flex-column h-100 pb-3">
    {% for image in images %}
        <img src="{{ image.formats['552x435'] }}" alt="{{ namePerson|raw  }}" class="img-fluid">
    {% endfor %}
    <figcaption class="flex-grow-1 d-flex flex-column px-1 px-lg-3 py-3">
        <div class="h6 text-black-50 text-uppercase mb-2">{{ namePerson|raw }}</div>

        <h2 class="h5 mb-3">
            {{ title|raw }}
        </h2>
        <div class="mt-auto">
            {{ description|raw }}
        </div>
        <div class="mt-1 text-secondary">
            {%  include 'components/button-orange-outline.html.twig'
                with {
                'width': 'full',
                'label': 'Lees mijn verhaal',
                'url': url,
                'extraClass': 'stretched-link'
            }
            %}
        </div>
    </figcaption>
</figure>
<footer>
    <div class="bg-dark py-2">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-md-6 col-sm-6 pb-4 pt-3">
                    <a href="{{ sulu_content_root_path() }}">
                        <img src="{{ asset('build/frontend/images/logo-werkenbij-bluekens-wit.svg') }}" alt="Werken bij Bluekens" class="img-fluid">
                    </a>
                </div>
                <div class="col-3 col-lg-1 col-sm-2 pb-4 pt-md-3">
                    <img src="{{ asset('build/frontend/images/BB-leerbedrijf-erkend.png') }}" alt="Erkend Leerbedrijf" class="img-fluid">
                </div>
                <div class="col-4 col-lg-1 col-sm-2 pb-4 pt-md-3 align-self-center">
                    <img src="{{ asset('build/frontend/images/JINC-logo_rgb.png') }}" alt="Partner van JINK" class="img-fluid">
                </div>
            </div>
            <div class="row">

                {% set footer = {
                    'locations' : sulu_snippet_load_by_area('footer_locations'),
                    'missed' : sulu_snippet_load_by_area('footer_missed'),
                    'jobs' : sulu_snippet_load_by_area('footer_jobs'),
                    'brands' : sulu_snippet_load_by_area('footer_brands')
                    }
                %}

                {% for key, footerblock in footer %}
                    {% if footerblock|length > 0 %}
                        <div class="col-md-6 col-lg-3 text-white pb-3">

                            <h5 class="h6  font-weight-bold text-white text-uppercase">{{ footerblock.content.title }}</h5>

                            <div class="row">
                                <div class="col-auto">

                                    {% set linkblocks = [ footerblock.content.links, footerblock.content.collection ] %}

                                    {% for linkblock in linkblocks %}
                                        {% for link in linkblock %}
                                            {% set linkContent = sulu_content_load(link.id) %}

                                            {% if key == 'locations'  %}
                                                <div class="d-flex justify-content-between">
                                                    {% set phone = linkContent.content.reception_phonenumber|striptags|replace({' ': ''}) %}

                                                    {% if phone|first == 0 %}
                                                        {% set phone = phone|split('0', 2) %}
                                                        {% set phone = '+31' ~ phone[0] ~ phone[1] %}
                                                    {% endif %}

                                                    <div class=" font-weight-light pr-5">{{ linkContent.content.city }}</div>
                                                    <div class=" font-weight-light">
                                                        <a href="tel:{{ phone }}" class="text-white" title="Bel vestiging {{ linkContent.content.city }}">
                                                            {{ linkContent.content.reception_phonenumber|raw }}
                                                        </a>
                                                    </div>
                                                </div>
                                            {% else %}
                                                {% if linkContent.content.location is defined %}
                                                    {% set location = sulu_content_load(linkContent.content.location) %}
                                                {% endif %}
                                                <div>
                                                    <a href="{{ linkContent.content.url }}" title="{{ linkContent.content.title }}" class="text-white  font-weight-light"><u>{{ linkContent.content.title }}</u></a>
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    {% endfor %}

                                    {% if footerblock.content.textblock is not empty %}
                                        <div class=" font-weight-light">
                                            {{  footerblock.content.textblock|raw }}
                                        </div>
                                    {% endif %}

                                </div>
                            </div>
                        </div>

                    {% endif %}
                {% endfor %}

            </div>
        </div>
    </div>

    <div class="bg-primary">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 py-1 col-md-auto d-flex flex-wrap">
                    <span class="text-white  font-weight-bold text-uppercase">
                        &copy; Bluekens Truck en Bus B.V. {{ 'now'|date('Y') }}
                    </span>
                    {% for item in sulu_navigation_root_tree('bottom-footer') %}
                        <span class="text-white-50  font-weight-light">
                            &nbsp;|&nbsp;<a href="{{ sulu_content_path(item.url, item.webspaceKey) }}" title="{{ item.title }}" class="text-white-50">{{ item.title }}</a>
                        </span>
                    {% endfor %}
                    <span class="text-white-50  font-weight-light">
                        &nbsp;|&nbsp;<a href="https://bluekenstruckenbus.nl/" target="_blank" title="Bluekenstruckenbus.nl" class="text-white-50">www.bluekenstruckenbus.nl</a>
                </div>
                <div class="col-12 col-md-auto ml-auto">
                    <div class="d-flex justify-content-md-end align-items-center">
                        <div class="">
                            <a href="https://www.linkedin.com/company/bluekens-truck-en-bus-b.v./" rel="noopener" target="_blank" class="d-block h-100 p-0_5 text-center text-white hover-txt-to-dark" title="LinkedIn">
                                <svg height="25" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="linkedin-in" class="svg-inline--fa fa-linkedin-in fa-w-14" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                    <path fill="currentColor" d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"></path>
                                </svg>
                            </a>
                        </div>
                        <div class="">
                            <a href="https://www.instagram.com/bluekenstruckenbus/?hl=nl" rel="noopener" target="_blank" class="d-block h-100 p-0_5 text-white hover-txt-to-dark text-center" title="Instagram">
                                <svg height="25" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="instagram" class="svg-inline--fa fa-instagram fa-w-14" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                                    <path fill="currentColor" d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"></path>
                                </svg>                            </a>
                        </div>
                        <div class="">
                            <a href="https://www.facebook.com/bluekenstruckenbus/" class="d-block h-100 p-0_5 text-white hover-txt-to-dark text-center" title="Facebook" rel="noopener" target="_blank">
                                <svg height="25" aria-hidden="true" focusable="false" data-prefix="fab" data-icon="facebook-f" class="svg-inline--fa fa-facebook-f fa-w-10" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512">
                                    <path fill="currentColor" d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"></path>
                                </svg>                            </a>
                        </div>
                        {#
                        <div class="" rel="noopener" target="_blank">
                            <a href="" rel="noopener" target="_blank" class="d-block h-100 p-0_5 text-center hover-bg-to-dark" title="Youtube">
                                <img src="{{ asset('build/frontend/images/youtube-brands.svg') }}" alt="Youtube" class="img-fluid" style="height:25px">
                            </a>
                        </div>
                        <div class="">
                            <a href="" rel="noopener" target="_blank" class="d-block h-100 p-0_5 text-center hover-bg-to-dark" title="Pinterest">
                                <img src="{{ asset('build/frontend/images/pinterest-p-brands.svg') }}" alt="Pinterest" class="img-fluid" style="height:25px">
                            </a>
                        </div>
                        #}
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>

{% if content.color == 'secondary' %}
    {% set listimage =  asset('build/frontend/images/list-image-secondary.svg') %}
{% else %}
    {% set listimage =  asset('build/frontend/images/list-image-primary.svg') %}
{% endif %}

<div class="container mb-3">
    <span class="bg-light border-left border-{{ content.color|default('primary') }} border-w-40 d-inline-block p-3 w-100">
        <h2 class="h5">
            {{ content.block_title is defined ? content.block_title : content.title }}
        </h2>
        {{ content.block_text is defined ? content.block_text|replace({
            '<ul>': '<ul class="mb-0 pl-1" style="list-style-image:url('~listimage~')">',
            '<li>': '<li class="pl-1">'
        })|raw : content.text|raw }}
    </span>
</div>


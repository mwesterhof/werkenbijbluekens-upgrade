<div class="container mb-lg-5">
    <div class="row">
        <div class="col-md-6">
            <h2 class="h5">
                {{ content.left_block_title is defined ? content.left_block_title|raw }}
            </h2>
            {{ content.left_block_text is defined ? content.left_block_text|raw }}

            {% if content.buttons_left is defined and content.buttons_left|length > 0 %}
                <div>
                    {% for button in content.buttons_left %}
                        {%  include 'components/button.html.twig'
                            with {
                                'extraClass': ''
                            }
                        %}
                    {% endfor %}
                </div>
            {% endif %}

        </div>
        <div class="col-md-6">
            <h2 class="h5">
                {{ content.right_block_title is defined ? content.right_block_title|raw }}
            </h2>
            {{ content.right_block_text is defined ? content.right_block_text|raw }}
            
            {% if content.buttons is defined and content.buttons|length > 0 %}
                <div>
                    {% for button in content.buttons %}
                        {%  include 'components/button.html.twig'
                            with {
                                'extraClass': 'd-flex d-lg-inline-flex'
                            }
                        %}
                    {% endfor %}
                </div>
            {% endif %}

        </div>
    </div>
</div>

<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>location</key>

    <view>pages/location</view>
    <controller>Sulu\Bundle\WebsiteBundle\Controller\DefaultController::indexAction</controller>

    <cacheLifetime>86400</cacheLifetime>

    <meta>
        <title lang="nl">Locatie</title>
    </meta>

    <properties>

        <xi:include href="includes/header.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/*)" />

        <xi:include href="includes/resource_locator.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/*)" />

        <xi:include href="includes/content_blocks.xml"
                    xpointer="xmlns(sulu=http://schemas.sulu.io/template/template) xpointer(/sulu:properties/*)"/>

        <section name="contact">
            <meta>
                <title lang="nl">Contact</title>
            </meta>
            <properties>
                <property name="contact_image" type="media_selection" colspan="6">
                    <meta>
                        <title lang="nl">Contactpersoon afbeelding</title>
                    </meta>
                </property>

                <property name="contact_title" type="text_line">
                    <meta>
                        <title lang="nl">Contact titel</title>
                        <!-- schema.org requirement -->
                    </meta>
                </property>

                <property name="contact_text" type="text_editor">
                    <meta>
                        <title lang="nl">Contact tekst</title>
                    </meta>
                </property>

                <property name="adres" type="text_editor">
                    <meta>
                        <title lang="nl">Adres</title>
                    </meta>
                </property>

                <property name="city" type="text_line">
                    <meta>
                        <title lang="nl">Plaats</title>
                        <!-- schema.org requirement -->
                    </meta>
                </property>

                <property name="country" type="text_line">
                    <meta>
                        <title lang="nl">Land</title>
                        <!-- schema.org requirement -->
                    </meta>
                </property>

                <property name="reception_phonenumber" type="text_line">
                    <meta>
                        <title lang="nl">Receptie telefoonnummer</title>
                    </meta>
                </property>
            </properties>
        </section>


        <property name="joboffers" type="smart_content">
            <meta>
                <title lang="nl">Vacatures</title>
            </meta>
            <params>
                <param name="provider" value="pages"/>
                <param name="max_per_page" value="1"/>
                <param name="page_parameter" value="p"/>
                <param name="properties" type="collection">
                    <param name="article" value="article"/>
                    <param name="location" value="location"/>
                    <param name="function_profile" value="function_profile"/>
                    <param name="number_of_hours" value="number_of_hours"/>
                    <param name="excerptTitle" value="excerpt.title"/>
                    <param name="excerptTags" value="excerpt.tags"/>
                    <param name="excerptImages" value="excerpt.images"/>
                    <param name="excerptDescription" value="excerpt.description"/>
                </param>
            </params>
        </property>


        <property name="location" type="location">
            <meta>
                <title lang="nl">Locatie</title>
            </meta>
        </property>

        <property name="opening_hours" type="text_editor">
            <meta>
                <title lang="nl">Openingstijden</title>
            </meta>
        </property>

        <section name="joboffer_form">
            <meta>
                <title lang="nl">Sollicicatie formulier</title>
            </meta>
            <properties>
                <property name="joboffer_image" type="media_selection" colspan="6">
                    <meta>
                        <title lang="nl">Afbeelding</title>
                    </meta>
                </property>

                <property name="form" type="single_form_selection">
                    <meta>
                        <title lang="nl">Formulier</title>
                    </meta>

                    <params>
                        <param name="resourceKey" value="page"/>
                    </params>
                </property>
            </properties>
        </section>

    </properties>
</template>
